# Windows: absolute path to the SDK root containing lib/ and include/.
SAPNWRFC_HOME=C:/nwrfc/nwrfcsdk

SAP_ASHOST_DEV=sap-dev.example.internal
SAP_SYSNR_DEV=01
SAP_CLIENT_DEV=100
SAP_USER_DEV=
SAP_PASSWORD_DEV=

SAP_ASHOST_SANDBOX=sap-sandbox.example.internal
SAP_SYSNR_SANDBOX=01
SAP_CLIENT_SANDBOX=200
SAP_USER_SANDBOX=
SAP_PASSWORD_SANDBOX=

# Продуктив — ТОЛЬКО ЧТЕНИЕ, системный пользователь (тип "B"), ADT не используется.
SAP_ASHOST_PROD=sap-prod.example.internal
SAP_SYSNR_PROD=01
SAP_CLIENT_PROD=100
SAP_USER_PROD=
SAP_PASSWORD_PROD=

# Политика чтения из PROD
SAP_PROD_MAX_ROWS=50
SAP_PROD_REQUIRE_WHERE=1

MCP_HOST=127.0.0.1
MCP_PORT=8000
