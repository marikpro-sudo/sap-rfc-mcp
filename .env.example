# Windows: absolute path to the SDK root containing lib/ and include/.
SAPNWRFC_HOME=C:/nwrfc/nwrfcsdk

SAP_ASHOST_DEV=sap-dev.example.internal
SAP_SYSNR_DEV=01
SAP_CLIENT_DEV=100
SAP_USER_DEV=
SAP_PASSWORD_DEV=

SAP_ASHOST_SANDBOX=sap-sandbox.example.internal
SAP_SYSNR_SANDBOX=01
SAP_CLIENT_SANDBOX=200
SAP_USER_SANDBOX=
SAP_PASSWORD_SANDBOX=

# Продуктив — ТОЛЬКО ЧТЕНИЕ, системный пользователь (тип "B"), ADT не используется.
SAP_ASHOST_PROD=sap-prod.example.internal
SAP_SYSNR_PROD=01
SAP_CLIENT_PROD=100
SAP_USER_PROD=
SAP_PASSWORD_PROD=

# Политика чтения. Все значения ниже — по умолчанию; строку можно не задавать.
# В PROD where_clause обязателен во всех режимах (0 — отключить, не рекомендуется).
SAP_PROD_REQUIRE_WHERE=1

# Строк в ответе read_table_data(output="inline"): обычный режим
# (SAP_PROD_MAX_ROWS — прежнее имя для PROD, учитывается, если SAP_LIMIT_INLINE_PROD не задан)
SAP_LIMIT_INLINE_PROD=50
SAP_LIMIT_INLINE_SANDBOX=200
# ... и если в fields не больше SAP_NARROW_MAX_FIELDS полей
SAP_NARROW_MAX_FIELDS=6
SAP_LIMIT_INLINE_NARROW_PROD=500
SAP_LIMIT_INLINE_NARROW_SANDBOX=1000
# Строк в файл, read_table_data(output="file")
SAP_LIMIT_FILE_PROD=20000
SAP_LIMIT_FILE_SANDBOX=100000
# Строк, просматриваемых aggregate_table_data
SAP_LIMIT_SCAN_PROD=200000
SAP_LIMIT_SCAN_SANDBOX=1000000
# Тайм-аут одного обращения к инструменту, секунд
SAP_TIMEOUT_PROD=120
SAP_TIMEOUT_SANDBOX=300
# Строк за один вызов RFC_READ_TABLE при постраничном чтении
SAP_PAGE_ROWS=20000
# Предел длины where_clause, символов
SAP_WHERE_MAX_LEN=1000

# Выгрузки CSV: папка вне OneDrive и других синхронизируемых папок (по умолчанию — exports рядом со скриптом)
SAP_EXPORT_DIR=C:/nwrfc/exports
# Файлы старше N дней удаляются при каждой новой выгрузке
SAP_EXPORT_KEEP_DAYS=30

MCP_HOST=127.0.0.1
MCP_PORT=8000
